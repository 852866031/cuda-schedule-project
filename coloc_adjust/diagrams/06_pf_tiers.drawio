<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="How the prefill tenant fits its budget (Qwen2.5-3B fp8 engine)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="s0" value="Running&lt;br&gt;&lt;small&gt;own kvcached limit = budget (≤ 8 GiB)&lt;br&gt;GPU: 4.5 GiB fixed + in-flight KV&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="s1" value="Holding&lt;br&gt;&lt;small&gt;new prompts wait at the adapter, in-flight ones finish&lt;br&gt;GPU: 4.5 GiB fixed&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="60" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="s2" value="Asleep&lt;br&gt;&lt;small&gt;vLLM sleep level 1: weights to host RAM, KV dropped; ≈ 260 ms each way&lt;br&gt;GPU: 1.4 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="d1" value="budget &lt; 0.5 GiB?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="idle for 3 s?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="d3" value="budget &gt; 1.5 GiB?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="200" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="No shape to shrink: an engine is weights + in-flight KV. The only moves are admitting fewer prompts, then leaving the GPU. The compute share made no difference." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="430" height="80" as="geometry"/></mxCell>
<mxCell id="p3" value="Where it binds: 4.5 GiB fixed leaves the decode engine 9.4 GiB of KV, exceeded from 2 req/s on. Asleep it holds 1.4 GiB but the scheduler still books 4.5: 3 GiB idle (next step)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="510" y="330" width="430" height="80" as="geometry"/></mxCell>
<mxCell id="a1" value="stop admitting" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s0" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="sleep" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="d1" target="s1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="170"/><mxPoint x="490" y="170"/></Array></mxGeometry></mxCell>
<mxCell id="a4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="d2" target="s2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="170"/><mxPoint x="820" y="170"/></Array></mxGeometry></mxCell>
<mxCell id="a5" value="yes: wake, admit again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="d3" target="d1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="300"/><mxPoint x="160" y="300"/></Array></mxGeometry></mxCell>
</root></mxGraphModel>
