<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="How the prefill tenant fits its budget, and what moves it (Qwen2.5-3B fp8 engine, round 2)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="30" as="geometry"/></mxCell>
<mxCell id="s0" value="Running&lt;br&gt;&lt;small&gt;its own kvcached limit = the published budget (256 MiB steps, at most 8 GiB); prompts admitted; finished KV streamed to a 3.5 GiB host tier. On the GPU: 4.5 GiB fixed + in-flight KV&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="s1" value="Holding&lt;br&gt;&lt;small&gt;budget under 0.5 GiB: new prompts wait at the adapter, in-flight ones finish; kvcached limit at its 256 MiB floor; admits again as soon as the budget is back. On the GPU: 4.5 GiB fixed&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="60" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="s2" value="Asleep&lt;br&gt;&lt;small&gt;vLLM sleep level 1: weights copied to host RAM, KV discarded, CUDA context kept. ≈ 260 ms each way. On the GPU: 1.4 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="d1" value="budget below 0.5 GiB?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="d2" value="holding for 3 s with nothing in flight?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="230" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="d3" value="budget back above 1.5 GiB (floor + 1 GiB margin)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="230" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="p1" value="Every 100 ms the adapter reads the scheduler's budget file and writes its own footprint (fixed + KV mapped) to the state file, exactly as the fine-tune tenant does. In-flight prompts are bounded by the kvcached limit, so a smaller budget is honoured as soon as they finish; no step is abandoned because a prefill is 71 ms." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="460" height="100" as="geometry"/></mxCell>
<mxCell id="p2" value="Unlike the fine-tune ladder (Diagram 3) there is no shape to shrink: an engine's memory is weights plus in-flight KV. The only moves are admitting fewer prompts, then leaving the GPU. The compute share (MPS, MPS 20 %, disjoint SMs) is fixed at start and made no measurable difference." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="370" width="440" height="100" as="geometry"/></mxCell>
<mxCell id="p3" value="Where it binds: 4.5 GiB fixed + 2 GiB reserved leave the decode engine 9.4 GiB of KV before the tenant's budget reaches zero, which happens from 2 req/s on. Asleep it really holds 1.4 GiB, but the scheduler still books 4.5 GiB: 3 GiB idle in every high-load phase. Crediting that back to the KV pool is the next step." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="930" height="80" as="geometry"/></mxCell>
<mxCell id="a1" value="stop admitting" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s0" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="sleep" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="d1" target="s1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="200"/><mxPoint x="515" y="200"/></Array></mxGeometry></mxCell>
<mxCell id="a4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="d2" target="s2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="200"/><mxPoint x="845" y="200"/></Array></mxGeometry></mxCell>
<mxCell id="a5" value="yes: wake, then admit again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="d3" target="d1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="340"/><mxPoint x="175" y="340"/></Array></mxGeometry></mxCell>
</root></mxGraphModel>
