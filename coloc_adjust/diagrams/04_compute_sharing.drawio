<mxCell id="l2dot" value="" style="ellipse;aspect=fixed;fillColor=#1f77b4;strokeColor=#1f77b4;" vertex="1" parent="l2"><mxGeometry x="10" y="7" width="14" height="14" as="geometry"/></mxCell>
<mxCell id="l3dot" value="" style="ellipse;aspect=fixed;fillColor=#2ca02c;strokeColor=#2ca02c;" vertex="1" parent="l3"><mxGeometry x="10" y="7" width="14" height="14" as="geometry"/></mxCell>
<mxCell id="l4dot" value="" style="ellipse;aspect=fixed;fillColor=none;strokeColor=#888888;dashed=1;" vertex="1" parent="l4"><mxGeometry x="10" y="7" width="14" height="14" as="geometry"/></mxCell>
