<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Six ways of sharing the GPU's compute (the memory loop is the same in all of them)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="920" height="30" as="geometry"/></mxCell>
<mxCell id="l1" value="Wait for idle windows" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#f5f5f5;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l1a" value="the engine reports when a decode step is running&lt;br&gt;&lt;small&gt;completion event after every step&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l1"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l1b" value="the tenant waits for a quiet moment before each transformer block" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l1"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l1c" value="result: with any request in flight the engine is busy ~100 % of the time, so the tenant starves" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="l1"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="l2" value="Share all SMs (MPS, no cap)" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#e8f4f8;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l2a" value="both processes run through MPS&lt;br&gt;&lt;small&gt;their kernels share all SMs&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l2b" value="the tenant runs as fast as its memory budget allows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l2"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l2c" value="result: decode per-token latency +20–30 % at 1–2 req/s; most training progress" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l2"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="l3" value="Cap the tenant's SM share (MPS, fixed 20 %)" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#fff0e6;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="350" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l3a" value="the tenant is limited to 20 % of the SMs&lt;br&gt;&lt;small&gt;fixed when it starts&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l3b" value="the tenant runs slower, within the cap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l3"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l3c" value="result: half the latency cost of sharing all SMs, for ~60 % of the training progress" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l3"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="l4" value="Change the tenant's SM count with the load (green context, dynamic)" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#e8f5e9;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l4a" value="the controller publishes an SM count that falls as the arrival rate rises (128 → 16)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l4"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l4b" value="the tenant creates a green context with that many SMs and switches to it between steps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l4"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l4c" value="result: every switch leaks allocator memory, the tenant runs out of memory and pauses; not usable in-process" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l4"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="l5" value="Give the engine fewer SMs (green context, 128 of 170)" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#fff9e6;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="650" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l5a" value="the engine's decode steps run on 128 SMs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l5"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l5b" value="the tenant gets the rest (dynamic, as above)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l5"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l5c" value="result: decode on 128 SMs is as fast as on all 170 — decode is limited by memory bandwidth, not by SMs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l5"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l1a" target="l1b" parent="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l1b" target="l1c" parent="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l2a" target="l2b" parent="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l2b" target="l2c" parent="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l3a" target="l3b" parent="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l3b" target="l3c" parent="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l4a" target="l4b" parent="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l4b" target="l4c" parent="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l5a" target="l5b" parent="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l5b" target="l5c" parent="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l6" value="Split the SMs between the two (green context, static)" style="swimlane;horizontal=1;startSize=28;fontStyle=1;align=left;spacingLeft=34;fillColor=#fce4ec;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="800" width="960" height="150" as="geometry"/></mxCell>
<mxCell id="l6a" value="the engine on 128 SMs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l6"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l6b" value="the tenant on the remaining 42 SMs, no switching" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l6"><mxGeometry x="330" y="50" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="l6c" value="result: tenant 10.5k tok/s, decode latency +26 % — the same as sharing all SMs: the contention is memory bandwidth" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l6"><mxGeometry x="640" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="x11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l6a" target="l6b" parent="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l6b" target="l6c" parent="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
