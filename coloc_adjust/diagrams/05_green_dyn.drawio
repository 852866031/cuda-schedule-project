<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="How the tenant's SM share follows the load (prebuilt dynamic green contexts, green_dyn2)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="30" as="geometry"/></mxCell>
<mxCell id="hl" value="VRAM scheduler, every 100 ms (same process as the memory loop)" style="text;html=1;fontSize=13;fontStyle=2;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="480" height="20" as="geometry"/></mxCell>
<mxCell id="hr" value="Tenant process, between training steps" style="text;html=1;fontSize=13;fontStyle=2;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="620" y="48" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="n1" value="Count the router's arrivals in the last 5 s&lt;br&gt;&lt;small&gt;the arrival rate is the earliest signal: KV demand and decode pressure follow it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="n2" value="Look up the tenant's SM share&lt;br&gt;&lt;small&gt;table by arrival rate: 0 req/s → 128 SMs, 0.5 → 96, 1 → 64, 2 → 32, 3 and above → 16; interpolated between rows, rounded to a multiple of 16 so the share changes rarely&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="q1" value="share differs from the one last published?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="p" value="publish the budget file: tenant bytes (memory loop, unchanged) + wanted SM count, at most once per second" style="shape=document;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="355" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="g3" value="keep as is" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="120" y="490" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="t0" value="At start: build every green context once&lt;br&gt;&lt;small&gt;128 / 96 / 64 / 32 / 16 SMs carved out of the 170 with the driver's SM-partition API, each with its own stream, before the first training allocation. Round 1 built and destroyed a context on every switch; that leaked memory and stalled.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="340" height="130" as="geometry"/></mxCell>
<mxCell id="t1" value="Before each step: read the budget file&lt;br&gt;&lt;small&gt;bytes → pick the tier on the ladder (Diagram 3, unchanged); SM count → wanted share&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="q2" value="wanted share differs from the current one, and the last switch was over 1 s ago?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="660" y="350" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="t2" value="Switch streams&lt;br&gt;&lt;small&gt;wait for the GPU to drain, take the prebuilt context nearest the wanted count, make its stream the tenant's current stream, return cached blocks. Nothing is created or destroyed; the switch costs one synchronisation.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="340" height="110" as="geometry"/></mxCell>
<mxCell id="t3" value="Run the step on that stream&lt;br&gt;&lt;small&gt;its kernels occupy only those SMs; the engine's decode kernels take whatever is left. Then back to the top for the next step.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="650" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="why" value="&lt;b&gt;Why fewer SMs at high load helps although the decode engine is not SM-bound:&lt;/b&gt;&lt;br&gt;&lt;small&gt;the decode cost of a tenant is set by the bytes it moves per token (shape probe, Figure 5). With fewer SMs the same step runs fewer weight-reading kernels at once, so the tenant's memory traffic is spread thinner exactly when the engine's own traffic is highest. Result: 9–12k tok/s for +14 % decode latency, half the cost of MPS sharing at 80 % of its throughput; 174 switches over a run, no leak.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="530" height="170" as="geometry"/></mxCell>
<mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="n2" target="q1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;" edge="1" source="q1" target="p" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="q1" target="g3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a5" value="/dev/shm budget file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" source="p" target="t1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="400"/><mxPoint x="595" y="280"/></Array></mxGeometry></mxCell>
<mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="t0" target="t1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="t1" target="q2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;" edge="1" source="q2" target="t2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" source="q2" target="t3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="405"/><mxPoint x="990" y="695"/></Array></mxGeometry></mxCell>
<mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="t2" target="t3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a11" value="next step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" source="t3" target="t1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="695"/><mxPoint x="600" y="300"/></Array></mxGeometry></mxCell>
</root></mxGraphModel>
