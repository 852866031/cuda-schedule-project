<mxCell id="n2" value="SM share by table&lt;br&gt;&lt;small&gt;0 req/s → 128 SMs&lt;br&gt;0.5 req/s → 96&lt;br&gt;1 req/s → 64&lt;br&gt;2 req/s → 32&lt;br&gt;≥ 3 req/s → 16&lt;br&gt;interpolated, rounded to 16&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="240" height="150" as="geometry"/></mxCell>
