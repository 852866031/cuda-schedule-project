<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="How the fine-tune tenant fits its budget, and what moves it" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="s0" value="Full batch&lt;br&gt;&lt;small&gt;15.9 GiB, fastest&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="s1" value="Smaller micro-batches&lt;br&gt;&lt;small&gt;2, 4 or 8 per step: 8.7 / 5.0 / 3.2 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="s2" value="+ activations kept in host RAM&lt;br&gt;&lt;small&gt;2.5 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="s3" value="+ part of the frozen weights streamed from host RAM&lt;br&gt;&lt;small&gt;2.2 / 1.9 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="s4" value="Paused&lt;br&gt;&lt;small&gt;everything saved to host RAM, 0.4 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="d1" value="budget below what the current shape needs?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="d2" value="engine busy most of the time?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="d3" value="budget fits a bigger shape, for 3 s?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="495" y="190" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="p1" value="During a step the tenant re-reads its budget every 50 ms. If the budget shrank, the step is abandoned and the shape stepped down at once." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="An out-of-memory error means the shape does not fit: step down. The tenant's allocator is capped at its budget, so it can never take the engine's memory." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="p3" value="Training state is saved to host RAM every 10 steps and before every move, so a pause or restart resumes where it left off." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="A compute share (when one is used) is changed only between steps, never in the middle of one." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="a1" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s0" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a4" value="budget still too small" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a5" value="yes: step down at once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;" edge="1" source="d1" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a6" value="yes: use smaller micro-batches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.15;entryY=1;" edge="1" source="d2" target="s1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="150"/><mxPoint x="288" y="150"/></Array></mxGeometry></mxCell>
<mxCell id="a7" value="yes: step up one" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;" edge="1" source="d3" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a8" value="budget is back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="s4" target="d3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="295"/><mxPoint x="600" y="295"/></Array></mxGeometry></mxCell>
</root></mxGraphModel>
