<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Tenant preemption tiers: what triggers each move" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="s0" value="T0 full batch&lt;br&gt;&lt;small&gt;8×512 · 15.9 GiB · 45k tok/s&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="s1" value="T1 micro-batches k=2/4/8&lt;br&gt;&lt;small&gt;grad accumulation · 8.7 / 5.0 / 3.2 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s2" value="T2 + activation offload&lt;br&gt;&lt;small&gt;saved tensors → pinned DRAM · 2.5 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s3" value="T3 + weight streaming&lt;br&gt;&lt;small&gt;12 / 20 base layers from DRAM · 2.2 / 1.9 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="s4" value="T4 pause&lt;br&gt;&lt;small&gt;snapshot, model+optimizer to host · 0.4 GiB&lt;/small&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="d1" value="budget &lt; need of the current cfg?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="190" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="d2" value="engine busy duty &gt; 60%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="d3" value="budget ≥ need of a higher cfg for 3 s?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p1" value="mid-step: block hook / gate wait polls the budget every 50 ms → Preempt, abort step, drop tier at once" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="p2" value="OOM anywhere → mark cfg as not fitting, drop a tier (never the engine's problem: allocator cap = budget)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="440" height="60" as="geometry"/></mxCell>
<mxCell id="p3" value="snapshot to DRAM every 10 steps and before every tier move; resume on start from it" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="p4" value="SM share (green context) switched between steps when the controller's published share changes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="440" height="60" as="geometry"/></mxCell>
<mxCell id="a1" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s0" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="shrink" style="endArrow=open;endSize=10;html=1;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a4" value="still too big" style="endArrow=open;endSize=10;html=1;fontColor=#B20000;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a5" value="yes: drop at once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;" edge="1" source="d1" target="s1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a6" value="yes: force k ≥ 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;exitX=0.5;exitY=0;entryX=0.15;entryY=1;" edge="1" source="d2" target="s1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="150"/><mxPoint x="288" y="150"/></Array></mxGeometry></mxCell>
<mxCell id="a7" value="yes: climb one cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;" edge="1" source="d3" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a8" value="budget back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="s4" target="d3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="295"/><mxPoint x="600" y="295"/></Array></mxGeometry></mxCell>
