<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Prefill engine as the tenant: who talks to whom" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="host" value="Host (one process each)" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="920" height="540" as="geometry"/></mxCell>
<mxCell id="lg" value="Chat load&lt;br&gt;&lt;small&gt;32 sessions, arrival rate 0.5–4 req/s&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="host"><mxGeometry x="20" y="50" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="ctl" value="Router + VRAM scheduler&lt;br&gt;&lt;small&gt;exact KV demand → 8B KV limit; the rest, minus the tenant's fixed footprint, is the budget&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="210" y="45" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="eng" value="8B decode engine&lt;br&gt;&lt;small&gt;vLLM + kvcached (instance b)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="560" y="50" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="dram" value="8B KV store&lt;br&gt;&lt;small&gt;host RAM, 25.5 GiB&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="800" y="45" width="110" height="80" as="geometry"/></mxCell>
<mxCell id="bud" value="budget file&lt;br&gt;&lt;small&gt;bytes the tenant may use&lt;/small&gt;" style="shape=document;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="210" y="190" width="100" height="70" as="geometry"/></mxCell>
<mxCell id="stf" value="state file&lt;br&gt;&lt;small&gt;tenant footprint&lt;/small&gt;" style="shape=document;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="host"><mxGeometry x="330" y="190" width="100" height="70" as="geometry"/></mxCell>
<mxCell id="plg" value="Prefill load&lt;br&gt;&lt;small&gt;3072-token prompts, 1 req/s, 1 output token&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="host"><mxGeometry x="20" y="320" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="ad" value="Prefill adapter&lt;br&gt;&lt;small&gt;budget → tenant KV limit; holds prompts under 0.5 GiB; sleeps the engine after 3 idle s; wakes above 1.5 GiB&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="210" y="310" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="pe" value="3B fp8 prefill engine&lt;br&gt;&lt;small&gt;vLLM + kvcached (instance c), prefill only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="host"><mxGeometry x="560" y="320" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="sink" value="3B KV sink&lt;br&gt;&lt;small&gt;host RAM, 3.5 GiB&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="host"><mxGeometry x="800" y="320" width="110" height="80" as="geometry"/></mxCell>
<mxCell id="wts" value="3B weights while asleep&lt;br&gt;&lt;small&gt;host RAM&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="host"><mxGeometry x="800" y="430" width="110" height="80" as="geometry"/></mxCell>
<mxCell id="gpu" value="GPU (31.35 GiB, shared)" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="300" height="540" as="geometry"/></mxCell>
<mxCell id="w" value="8B weights + runtime ≈ 17 GiB&lt;br&gt;&lt;small&gt;fixed, measured at start&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#cfe3cf;strokeColor=#82b366;" vertex="1" parent="gpu"><mxGeometry x="20" y="40" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="kv" value="8B KV of in-flight requests&lt;br&gt;&lt;small&gt;elastic, up to the scheduler's limit&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#2a9d8f;strokeColor=#1d6f66;fontColor=#ffffff;" vertex="1" parent="gpu"><mxGeometry x="20" y="170" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="pw" value="3B weights + context 4.5 GiB&lt;br&gt;&lt;small&gt;1.4 GiB while asleep; booked as fixed&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="gpu"><mxGeometry x="20" y="290" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="pk" value="3B in-flight KV&lt;br&gt;&lt;small&gt;≤ the published budget&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e9c46a;strokeColor=#b8860b;" vertex="1" parent="gpu"><mxGeometry x="20" y="390" width="260" height="70" as="geometry"/></mxCell>
