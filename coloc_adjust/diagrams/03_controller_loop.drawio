<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="What the controller does every 100 ms (inference first)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="n1" value="Read the router's table&lt;br&gt;&lt;small&gt;what is running, what is waiting, how much KV each holds and will still need&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="Predict the engine's KV need&lt;br&gt;&lt;small&gt;KV of running + waiting requests at their final length, plus one second of new arrivals at the recent rate, plus a safety margin&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="q1" value="need above the current limit?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="g1" value="Grow at once&lt;br&gt;&lt;small&gt;raise the limit to the need, tell kvcached, give the tenant a smaller budget&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="q2" value="need at least 1 GiB below the limit, for 5 s?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="g2" value="Shrink&lt;br&gt;&lt;small&gt;lower the limit to the need, but never below what running requests hold plus the next waiting request; the tenant's budget rises only once the engine has actually released the memory&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="g3" value="keep as is" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="110" y="560" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="p" value="publish the tenant's budget: total VRAM − engine weights − safety margin − KV limit" style="shape=document;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="360" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="eng" value="kvcached, inside the engine&lt;br&gt;&lt;small&gt;growing: maps memory as requests need it; if the tenant still holds it, requests wait (never fail). shrinking: memory is released as requests finish&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="n2" target="q1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;" edge="1" source="q1" target="g1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="q1" target="q2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#2D7600;" edge="1" source="q2" target="g2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="q2" target="g3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="g1" target="p" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="g2" target="p" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a9" value="set the KV limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=0;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" source="g1" target="eng" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="200"/></Array></mxGeometry></mxCell>
</root></mxGraphModel>
