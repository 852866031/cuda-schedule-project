<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Colocation VRAM-adjust prototype: who talks to whom" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="host" value="Host (one process each)" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="760" height="500" as="geometry"/></mxCell>
<mxCell id="lg" value="Load generator&lt;br&gt;&lt;small&gt;32 chat sessions, arrival rate changes over time&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="host"><mxGeometry x="20" y="50" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="rt" value="Router&lt;br&gt;&lt;small&gt;sees every request: prompt length, tokens generated so far, waiting or running&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="220" y="50" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="ctl" value="VRAM scheduler (every 100 ms)&lt;br&gt;&lt;small&gt;predicts how much KV the engine needs, sets the engine's KV limit, gives the rest to the tenant&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="220" y="175" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="bud" value="shared budget file&lt;br&gt;&lt;small&gt;how much VRAM (and compute) the tenant may use right now&lt;/small&gt;" style="shape=document;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="220" y="305" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="ft" value="Fine-tune tenant (Qwen-0.5B LoRA)&lt;br&gt;&lt;small&gt;shrinks, offloads or pauses itself to fit the budget&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="host"><mxGeometry x="220" y="420" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="eng" value="vLLM + kvcached&lt;br&gt;&lt;small&gt;decode engine; session prefixes come from host RAM&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="460" y="50" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="obs" value="observation patch&lt;br&gt;&lt;small&gt;reports when the engine is busy; records every host↔GPU copy&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="host"><mxGeometry x="460" y="175" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="dram" value="KV store in host RAM&lt;br&gt;&lt;small&gt;every session's prefix&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="host"><mxGeometry x="650" y="310" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="snap" value="training snapshot&lt;br&gt;&lt;small&gt;in host RAM&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="host"><mxGeometry x="650" y="420" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="gpu" value="GPU (31.35 GiB, shared)" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="300" height="500" as="geometry"/></mxCell>
<mxCell id="w" value="engine weights + runtime 17.7 GiB (fixed)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#cfe3cf;strokeColor=#82b366;" vertex="1" parent="gpu"><mxGeometry x="20" y="40" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="kv" value="KV of in-flight requests (elastic)&lt;br&gt;&lt;small&gt;kvcached maps memory on demand, up to the limit&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#2a9d8f;strokeColor=#1d6f66;fontColor=#ffffff;" vertex="1" parent="gpu"><mxGeometry x="20" y="200" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="tn" value="tenant memory&lt;br&gt;&lt;small&gt;whatever is left below the KV limit (its allocator cap)&lt;/small&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e9c46a;strokeColor=#b8860b;" vertex="1" parent="gpu"><mxGeometry x="20" y="340" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;" edge="1" source="lg" target="rt" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="forwards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" source="rt" target="eng" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="what is running / waiting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;" edge="1" source="rt" target="ctl" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="set KV limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" source="ctl" target="eng" parent="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="197"/><mxPoint x="430" y="110"/></Array></mxGeometry></mxCell>
<mxCell id="e5" value="budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;" edge="1" source="ctl" target="bud" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="re-read every 50 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="bud" target="ft" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="busy?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.88;entryY=0;" edge="1" source="obs" target="ft" parent="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="400"/><mxPoint x="440" y="400"/></Array></mxGeometry></mxCell>
<mxCell id="e8" value="load / store KV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0.5;entryY=0;" edge="1" source="eng" target="dram" parent="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="110"/></Array></mxGeometry></mxCell>
<mxCell id="e9" value="save every 10 steps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="ft" target="snap" parent="host"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;strokeColor=#1d6f66;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="eng" target="kv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="145"/><mxPoint x="820" y="315"/></Array></mxGeometry></mxCell>
<mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;strokeColor=#b8860b;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="ft" target="tn" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="575"/><mxPoint x="990" y="575"/></Array></mxGeometry></mxCell>
<mxCell id="leg" value="red: the inference-first action (the KV limit grows at once); dashed: observation only; gold: the tenant's memory cap follows the published budget" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1100" height="30" as="geometry"/></mxCell>
</root></mxGraphModel>
