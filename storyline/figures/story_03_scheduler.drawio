<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="VRAM scheduler: one check every 100 ms" style="text;html=1;whiteSpace=wrap;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="34" as="geometry"/></mxCell>
<mxCell id="in" value="&lt;b style=&quot;font-size:15px&quot;&gt;Router&#x27;s table&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;running and waiting requests&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;arrival rate λ&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="need" value="&lt;b style=&quot;font-size:15px&quot;&gt;KV need&amp;nbsp; = &amp;nbsp;D &amp;nbsp;+&amp;nbsp; A &amp;nbsp;+&amp;nbsp; H&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;D&lt;/b&gt; &amp;nbsp;KV of running + waiting requests, at their final length&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;A&lt;/b&gt; &amp;nbsp;arrivals expected in the next 1 s:&amp;nbsp; λ × 1 s × KV per request&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;H&lt;/b&gt; &amp;nbsp;headroom, 0.5 GiB&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#174ea6;strokeWidth=2;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="660" height="120" as="geometry"/></mxCell>
<mxCell id="q1" value="need &amp;gt; limit ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f1f3f4;strokeColor=#9aa0a6;fontColor=#202124;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="grow" value="&lt;b style=&quot;font-size:15px&quot;&gt;Grow: after 1 check&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;tenant&#x27;s budget down first&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;limit up, as far as memory is free&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#d2e3fc;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="330" y="225" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="bud" value="&lt;b style=&quot;font-size:15px&quot;&gt;Tenant&#x27;s budget&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;= card − engine − margins − &lt;b&gt;KV limit&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#e37400;strokeWidth=2;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="shrink" value="&lt;b style=&quot;font-size:15px&quot;&gt;Shrink: after 50 checks in a row (5 s)&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;limit down, never below what requests hold&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;tenant&#x27;s budget up once memory is back&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#fde9c8;strokeColor=#e37400;strokeWidth=2;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="330" y="485" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="q2" value="need &amp;lt; limit − 1 GiB ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f1f3f4;strokeColor=#9aa0a6;fontColor=#202124;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="keep" value="&lt;b style=&quot;font-size:15px&quot;&gt;no change&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#f1f3f4;strokeColor=#9aa0a6;strokeWidth=1;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="100" y="625" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="kvc" value="&lt;b style=&quot;font-size:15px&quot;&gt;kvcached&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;maps and frees KV pages;&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;running requests are never cut&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="770" y="355" width="220" height="100" as="geometry"/></mxCell>
